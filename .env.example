# Copy to .env (gitignored). Used by docker compose, dbmate, and the app.
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=change-me
POSTGRES_DB=restaurant_dev

DATABASE_URL=postgres://restaurant:change-me@127.0.0.1:5432/restaurant_dev?sslmode=disable
TEST_DATABASE_URL=postgres://restaurant:change-me@127.0.0.1:5432/restaurant_test?sslmode=disable

DBMATE_MIGRATIONS_DIR=./db/migrations
DBMATE_NO_DUMP_SCHEMA=true
DBMATE_STRICT=true

DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
